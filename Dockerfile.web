# ---- Build stage: Flutter web ----
FROM gmeligio/flutter-android:3.47.9 AS builder

WORKDIR /app
COPY pubspec.* ./
COPY tool/cnativeapi/ tool/cnativeapi/
COPY tool/linux_native_deps/ tool/linux_native_deps/
RUN flutter pub get
RUN flutter config --enable-web
COPY . .
ARG BRAND=pistisai
ARG PISTISAI_ADMIN_EMAIL=
ARG SUPABASE_URL=
ARG SUPABASE_ANON_KEY=
ARG PISTISAI_PRICE_PREMIUM=
ARG PISTISAI_PRICE_ENTERPRISE=
RUN flutter build web --release --no-web-resources-cdn \
    --dart-define=BRAND=$BRAND \
    --dart-define=PISTISAI_ADMIN_EMAIL=$PISTISAI_ADMIN_EMAIL \
    --dart-define=SUPABASE_URL=$SUPABASE_URL \
    --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY \
    --dart-define=PISTISAI_PRICE_PREMIUM=$PISTISAI_PRICE_PREMIUM \
    --dart-define=PISTISAI_PRICE_ENTERPRISE=$PISTISAI_PRICE_ENTERPRISE \
 && python3 -c 'import json,pathlib; m=json.loads(pathlib.Path("assets/version.json").read_text()); p=pathlib.Path("build/web/index.html"); p.write_text(p.read_text().replace("$FLUTTER_BUILD_NUMBER", m["version"]+"."+str(m["build_number"])))'

# ---- Serve stage: Nginx ----
FROM nginx:alpine

COPY --from=builder /app/build/web /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=5 CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
