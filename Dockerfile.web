# syntax=docker/dockerfile:1
# ---- Build stage: Flutter web ----
# BRAND picks brand/<id>/. A tree that already has that brand baked and
# committed builds as is. Otherwise a paid white-label brand needs its licence
# as a build secret:
#   docker build -f Dockerfile.web --build-arg BRAND=acme \
#     --secret id=brand_licence,src=acme.licence .
FROM gmeligio/flutter-android:3.47.9 AS builder

# The image runs as flutter (uid 1001). /app and every COPY must belong to it,
# or pub get and the brand bake cannot write .dart_tool and generated files.
USER root
# cnativeapi's build hook runs on every build, web included, and asks
# pkg-config for GTK 3, X11 and Xi (see tool/linux_native_deps).
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      clang cmake ninja-build pkg-config \
      libgtk-3-dev libx11-dev libxi-dev liblzma-dev \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /app && chown flutter:flutter /app
USER flutter
WORKDIR /app
COPY --chown=flutter:flutter pubspec.* ./
COPY --chown=flutter:flutter tool/cnativeapi/ tool/cnativeapi/
COPY --chown=flutter:flutter tool/linux_native_deps/ tool/linux_native_deps/
RUN flutter pub get
RUN flutter config --enable-web
ARG BRAND=pistisai
COPY --chown=flutter:flutter . .
RUN --mount=type=secret,id=brand_licence,required=false \
    if grep -q "^  id: \"$BRAND\",$" lib/brand/active_brand.g.dart; then \
      echo "Brand $BRAND is already baked in the source tree"; \
    elif [ "$BRAND" != "pistisai" ]; then \
      if [ -f /run/secrets/brand_licence ]; then \
        dart run tool/brand_codegen.dart "$BRAND" --license /run/secrets/brand_licence; \
      else \
        dart run tool/brand_codegen.dart "$BRAND"; \
      fi; \
    fi
# Values are BuildKit secrets, not build-args, so image provenance does not record them.
# mode=0444: the build runs as the flutter user, and secrets are root-only by default.
RUN --mount=type=secret,id=PISTISAI_ADMIN_EMAIL,required=true,mode=0444 \
    --mount=type=secret,id=CF_ACCESS_TEAM_DOMAIN,required=true,mode=0444 \
    --mount=type=secret,id=CF_ACCESS_AUD,required=true,mode=0444 \
    --mount=type=secret,id=PISTISAI_PRICE_PREMIUM,required=true,mode=0444 \
    --mount=type=secret,id=PISTISAI_PRICE_ENTERPRISE,required=true,mode=0444 \
    secret() { if [ -f "/run/secrets/$1" ]; then tr -d '\r\n' < "/run/secrets/$1"; fi; } && \
    for s in PISTISAI_ADMIN_EMAIL CF_ACCESS_TEAM_DOMAIN CF_ACCESS_AUD PISTISAI_PRICE_PREMIUM PISTISAI_PRICE_ENTERPRISE; do \
      v="$(secret "$s")"; \
      if [ -z "$v" ]; then echo "missing BuildKit secret: $s" >&2; exit 1; fi; \
    done && \
    flutter build web --release --no-web-resources-cdn \
    --dart-define=BRAND="$BRAND" \
    --dart-define=PISTISAI_ADMIN_EMAIL="$(secret PISTISAI_ADMIN_EMAIL)" \
    --dart-define=CF_ACCESS_TEAM_DOMAIN="$(secret CF_ACCESS_TEAM_DOMAIN)" \
    --dart-define=CF_ACCESS_AUD="$(secret CF_ACCESS_AUD)" \
    --dart-define=PISTISAI_PRICE_PREMIUM="$(secret PISTISAI_PRICE_PREMIUM)" \
    --dart-define=PISTISAI_PRICE_ENTERPRISE="$(secret PISTISAI_PRICE_ENTERPRISE)" \
 && python3 -c 'import json,pathlib; m=json.loads(pathlib.Path("assets/version.json").read_text()); p=pathlib.Path("build/web/index.html"); p.write_text(p.read_text().replace("$FLUTTER_BUILD_NUMBER", m["version"]+"."+str(m["build_number"])))'

# ---- Serve stage: Nginx ----
FROM nginx:alpine

COPY --from=builder /app/build/web /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=5 CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
