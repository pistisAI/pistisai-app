# Pistisai local development environment variables
# Copy this file to `.env` and adjust values as needed.
# This file is for local development only and should NOT be committed with secrets.

# =============================================================================
# BACKEND
# =============================================================================
NODE_ENV=development
PORT=3000

# Cloudflare Access for the free-tier pistisai.app tunnel.
# Defaults are public. Override only if the Access app changes.
# CF_ACCESS_TEAM_DOMAIN=pistisai.cloudflareaccess.com
# CF_ACCESS_ISSUER=https://pistisai.cloudflareaccess.com
# CF_ACCESS_AUD=c0134585f8067b43908572f93046917aedfb9b8d111f3ed716e3fc204e8fe7d3

# Database
DATABASE_URL=postgres://user:password@localhost:5432/pistisai

# =============================================================================
# DEV BYPASS TOKEN
# =============================================================================
# Optional local-only bypass for authentication during development.
# When set and NODE_ENV != 'production', requests using this token value
# are treated as authenticated without a real Supabase JWT.
# Leave unset (or empty) to disable. Generate a random value locally, e.g.:
#   openssl rand -hex 32
# Never commit a real bypass token.
DEV_BYPASS_TOKEN=
