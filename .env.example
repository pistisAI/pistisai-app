# Pistisai local development environment variables
# Copy this file to `.env` and adjust values as needed.
# This file is for local development only and should NOT be committed with secrets.

# =============================================================================
# BACKEND
# =============================================================================
NODE_ENV=development
PORT=3000

# Supabase Auth
SUPABASE_URL=https://bpqwsjshoqxvtdttzvbr.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
DATABASE_URL=postgres://user:password@localhost:5432/pistisai

# =============================================================================
# DEV BYPASS TOKEN
# =============================================================================
# Optional local-only bypass for authentication during development.
# When set and NODE_ENV != 'production', requests using this token value
# are treated as authenticated without a real Supabase JWT.
# Defaults to `mock_dev_access_token` if unset.
DEV_BYPASS_TOKEN=mock_dev_access_token
