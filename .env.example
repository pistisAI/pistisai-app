# Pistisai local development environment variables
# Copy this file to `.env` and adjust values as needed.
# This file is for local development only and should NOT be committed with secrets.

# =============================================================================
# BACKEND
# =============================================================================
NODE_ENV=development
PORT=3000

# Cloudflare Access
CLOUDFLARE_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_AUDIENCE=your-application-uuid
CLOUDFLARE_CLIENT_ID=your-client-id
CLOUDFLARE_CLIENT_SECRET=your-client-secret

# Database
DATABASE_URL=postgres://user:***@localhost:5432/pistisai
# Required by docker-compose.yml (no default). Use a local value for dev;
# applied only when the postgres_data volume is first created.
POSTGRES_PASSWORD=CHANGE_ME

# =============================================================================
# DEV BYPASS TOKEN
# =============================================================================
# Optional local-only bypass for authentication during development.
# When set and NODE_ENV is exactly 'development', requests using this token value
# are treated as authenticated without a real Cloudflare Access token.
# Leave unset (or empty) to disable. Generate a random value locally, e.g.:
#   openssl rand -hex 32
# Never commit a real bypass token.
DEV_BYPASS_TOKEN=

# =============================================================================
# WEBHOOK AND INTERNAL ENDPOINT SECRETS
# =============================================================================
# HMAC-SHA256 secret for the OpenClaw agent-events webhook
# (api-backend /api/agent/events). The signature covers the raw request body.
# Without it the webhook answers 500 and accepts nothing; no JWT_SECRET fallback.
OPENCLAW_WEBHOOK_SECRET=
# Bearer token for the streaming-proxy /stats endpoint. Without it /stats
# answers 401 to every caller.
PROXY_STATS_TOKEN=
