FROM debian:sid

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies for Xvfb, window manager, VNC, screen recording, and Flutter Linux app
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    xvfb \
    openbox \
    x11vnc \
    fluxbox \
    libgl1 \
    libgl1-mesa-dri \
    libgtk-3-0 \
    libsecret-1-0 \
    libayatana-appindicator3-1 \
    libnotify4 \
    libnss3 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    ffmpeg \
    procps \
    # GStreamer for Flutter media/plugins
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    libgstreamer-plugins-bad1.0-0 \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

WORKDIR /app

# Copy only the built Flutter app (expects build/linux/x64/release/bundle)
COPY build/linux/x64/release/bundle /app/bundle

# Copy test scripts
COPY scripts/start_test_desktop.sh /app/start_test_desktop.sh
COPY scripts/cleanup_virtual.sh /app/cleanup_virtual.sh

RUN chmod +x /app/start_test_desktop.sh /app/cleanup_virtual.sh && \
    chown -R testuser:testuser /app

USER testuser

# Default: start test desktop with app
CMD ["/app/start_test_desktop.sh", "--with-app", "--wait"]
