# ============================================================================
# Pistisai Production Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# Domain Configuration
# ============================================================================
# Your main domain (without https://)
DOMAIN=yourdomain.com

# Email for Let's Encrypt SSL certificates
SSL_EMAIL=admin@yourdomain.com

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_DB=pistisai
POSTGRES_USER=appuser
# IMPORTANT: Change this to a strong password!
POSTGRES_PASSWORD=changeme_generate_strong_password

# ============================================================================
# JWT Configuration
# ============================================================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=changeme_generate_strong_jwt_secret

# ============================================================================
# Application Configuration
# ============================================================================
LOG_LEVEL=info
NODE_ENV=production

# ============================================================================
# Optional: Error Tracking
# ============================================================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ============================================================================
# Supabase Configuration
# ============================================================================
# Your Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co
# Your Supabase JWT Secret (found in Project Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=your-jwt-secret
# Supabase Audience (usually 'authenticated')
SUPABASE_AUDIENCE=authenticated
# (Optional) JWKS URI - usually: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URI=

