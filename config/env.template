# ============================================================================
# Pistisai Production Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# Domain Configuration
# ============================================================================
# Your main domain (without https://)
DOMAIN=yourdomain.com

# Email for Let's Encrypt SSL certificates
SSL_EMAIL=admin@yourdomain.com

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_DB=pistisai
POSTGRES_USER=appuser
# IMPORTANT: Change this to a strong password!
POSTGRES_PASSWORD=changeme_generate_strong_password

# ============================================================================
# JWT Configuration
# ============================================================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=changeme_generate_strong_jwt_secret

# ============================================================================
# Application Configuration
# ============================================================================
LOG_LEVEL=info
NODE_ENV=production

# ============================================================================
# Optional: Error Tracking
# ============================================================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ============================================================================
# Cloudflare Access (free-tier pistisai.app tunnel)
# ============================================================================
# Public defaults. Override only when the Access application changes.
# CF_ACCESS_TEAM_DOMAIN=pistisai.cloudflareaccess.com
# CF_ACCESS_ISSUER=https://pistisai.cloudflareaccess.com
# CF_ACCESS_JWKS_URL=https://pistisai.cloudflareaccess.com/cdn-cgi/access/certs
# CF_ACCESS_AUD=c0134585f8067b43908572f93046917aedfb9b8d111f3ed716e3fc204e8fe7d3
# Customer Tailscale/VPN deployments set this and do not call Access.
# PISTISAI_TUNNEL_AUTH=customer

