# ============================================================================
# Runtime Dockerfile for Pistisai Streaming Proxy
# Uses standard Node.js Alpine images
# ============================================================================

FROM node:24-alpine

WORKDIR /app

COPY services/streaming-proxy/package*.json ./
# Lockfiles are gitignored repo-wide, so npm ci cannot run in CI images.
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

COPY services/streaming-proxy/ ./

RUN chown -R node:node /app

USER node

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

CMD ["node", "proxy-server.js"]
