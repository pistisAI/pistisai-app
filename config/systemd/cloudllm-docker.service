[Unit]
Description=Pistisai Docker Admin Daemon
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/pistisai
ExecStart=/bin/bash /opt/pistisai/scripts/setup/docker_startup_vps.sh
ExecStop=/usr/bin/docker compose -f /opt/pistisai/config/docker/docker-compose.admin.yml down

[Install]
WantedBy=multi-user.target 