# Pistisai Production Environment Variables Template
# Copy this file to .env.production and fill in your values

# =============================================================================
# CLOUDFLARE ACCESS (Required for free-tier pistisai.app tunnel auth)
# =============================================================================
# Team domain host only (no scheme)
CF_ACCESS_TEAM_DOMAIN=pistisai.cloudflareaccess.com

# Application audience (AUD) from the Access application
CF_ACCESS_AUD=

# Optional JWKS override; defaults to https://$CF_ACCESS_TEAM_DOMAIN/cdn-cgi/access/certs
CF_ACCESS_JWKS_URI=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Your main domain
DOMAIN=pistisai.app

# API URL
API_URL=https://api.pistisai.app

# WebSocket URL
WS_URL=wss://api.pistisai.app

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Sentry DSN (optional)
SENTRY_DSN=

# OpenTelemetry endpoint (optional)
OTLP_ENDPOINT=

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Set to 'production' for production builds
NODE_ENV=production

# Logging level
LOG_LEVEL=info
