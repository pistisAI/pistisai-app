<?xml version="1.0" encoding="utf-8"?>
<!-- Opt out of Android system backup (Android 12+). Nothing the app stores
     is copied to cloud backups or to another device during transfer, in line
     with "Nothing leaves the device without consent" (AGENTS.md, #1016). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
